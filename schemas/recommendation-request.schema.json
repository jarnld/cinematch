{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinematch.app/schemas/recommendation-request.schema.json",
  "title": "Recommendation request",
  "type": "object",
  "additionalProperties": false,
  "required": ["region", "runtimeMaxMinutes", "moods", "pace", "company", "serviceIds"],
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "region": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "runtimeMaxMinutes": {
      "type": "integer",
      "minimum": 60,
      "maximum": 300
    },
    "moods": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": ["warm", "tense", "funny", "transporting", "dark", "romantic"]
      }
    },
    "pace": {
      "enum": ["slow", "meditative", "balanced", "fast", "relentless", "surprise"]
    },
    "company": {
      "enum": ["solo", "date", "partner", "friends", "family", "kids"]
    },
    "actorIds": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "serviceIds": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "kidsPresent": {
      "type": "boolean"
    },
    "excludedMovieIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "previousMovieId": {
      "type": "string",
      "minLength": 1
    },
    "refinement": {
      "enum": ["lighter", "tenser", "faster", "slower", "shorter", "wildcard"]
    }
  }
}
